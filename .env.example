# Adreoz Server Manager — environment configuration
#
# Copy to `.env` and adjust. Every value is optional; the defaults are tuned
# for a single-user local install on http://127.0.0.1:8080.
#
# Environment variables use the ASM_ prefix.

# --- Network --------------------------------------------------------------
# Bind to loopback by default. Put a TLS reverse proxy in front of the panel
# before exposing it to a network or the internet.
ASM_HOST=127.0.0.1
ASM_PORT=8080

# development | production
# development enables /docs and /openapi.json; production disables them.
ASM_ENVIRONMENT=development

# --- Storage --------------------------------------------------------------
# Absolute path to the data directory. Holds the SQLite database, server
# files, backups, and logs. Defaults to <project>/data.
# ASM_DATA_DIR=/srv/adreoz/data
#
# The data directory contains password hashes, session digests, and the audit
# trail. The panel creates it (and the SQLite database) with owner-only
# permissions: 0700 for directories and 0600 for the database file.

# Override the database connection. Defaults to sqlite:///<data>/asm.db.
# ASM_DATABASE_URL=sqlite:////srv/adreoz/data/asm.db

# --- Sessions -------------------------------------------------------------
ASM_SESSION_COOKIE_NAME=asm_session
ASM_SESSION_LIFETIME_HOURS=24
ASM_COOKIE_SAMESITE=lax

# Set to true only when the panel is served over HTTPS.
ASM_COOKIE_SECURE=false

# --- Login rate limiting --------------------------------------------------
ASM_LOGIN_ATTEMPT_LIMIT=10
ASM_LOGIN_ATTEMPT_WINDOW_SECONDS=300

# --- Reverse proxy --------------------------------------------------------
# Set true only when a trusted proxy sets X-Forwarded-For/X-Real-IP.
ASM_TRUST_PROXY_HEADERS=false

# Comma-separated allowlist of Host headers the panel will answer. Requests
# with any other Host are rejected with 400. Add the public hostname here when
# running behind a reverse proxy, for example: asm.example.com
ASM_TRUSTED_HOSTS=127.0.0.1,localhost,[::1]

# --- Safety ---------------------------------------------------------------
# The panel refuses to run as root. Do not enable this unless you accept the
# risk; the recommended deployment uses a dedicated unprivileged user.
ASM_ALLOW_ROOT=false

# --- Logging --------------------------------------------------------------
ASM_LOG_LEVEL=info
